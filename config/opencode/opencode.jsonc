{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna"
    },
    "general": {
        "model": "openai/gpt-5.6-terra"
    },
    "title": {
      "model": "openai/gpt-5.6-luna"
    },
    "summary": {
      "model": "openai/gpt-5.6-luna"
    },
    "compaction": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "rm *": "deny"
    },
    "external_directory": {
      "~/.cargo/registry/**": "allow"
    },
    "edit": {
      "~/.cargo/registry/**": "deny"
    }
  }
}
