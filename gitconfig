[user]
	name = Grant Slape
	email = me@grantslape.com
	signingkey = B93E18E1C515C600
[credential]
	helper = osxkeychain
[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[filter "lfs"]
	clean = git lfs clean %f
	smudge = git lfs smudge %f
	required = true
[color]
	ui = auto
[commit]
	gpgsign = true
[gpg]
	program = gpg
[url "git@github.com:"]
    insteadOf = https://github.com/
[pull]
	rebase = true
[core]
    pager = delta
	excludesfile = /Users/grant/.gitignore

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true
    tabs = 4

[merge]
    conflictstyle = zdiff3
[init]
	defaultBranch = main
