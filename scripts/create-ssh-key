#!/usr/bin/env bash

set -euo pipefail

key_path="${HOME}/.ssh/id_ed25519"
public_key_path="${key_path}.pub"

mkdir -p -m 700 "${HOME}/.ssh"

if [[ -f "${key_path}" ]]; then
  chmod 600 "${key_path}"
  if [[ ! -f "${public_key_path}" ]]; then
    ssh-keygen -y -f "${key_path}" > "${public_key_path}"
  fi
  chmod 644 "${public_key_path}"
  printf 'SSH key already exists: %s\n' "${key_path}"
  exit 0
fi

if [[ -e "${public_key_path}" ]]; then
  printf 'Refusing to overwrite %s without its private key.\n' "${public_key_path}" >&2
  exit 1
fi

ssh-keygen -t ed25519 -a 100 -f "${key_path}" -C "me@grantslape.com"
printf 'Created SSH public key: %s\n' "${public_key_path}"
